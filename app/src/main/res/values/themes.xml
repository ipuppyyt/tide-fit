<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TideFit.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0B0D10</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.TideFit</item>
    </style>

    <style name="Theme.TideFit" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/tide_window_bg</item>
